# Copie para .env e ajuste. No Render estas variáveis são definidas no dashboard
# (exceto DATABASE_URL, que o Blueprint conecta automaticamente ao banco).

SECRET_KEY=troque-esta-chave
DEBUG=True
# Para testar no Expo Go em celular físico, adicione o IP da sua máquina na
# rede local (ex.: 192.168.0.10) — o celular acessa a API por esse IP, não por localhost.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.0.10

# Local: aponte para o seu Postgres. No Render: injetado automaticamente.
DATABASE_URL=postgres://tocauser:toca123@localhost:5432/toca_espanhol

# Origens do frontend permitidas (separadas por vírgula). O app Expo Go não
# envia Origin (não é navegador), então CORS não se aplica a ele — isto fica
# aqui apenas para o preview web do Expo (`expo start --web`), se usado.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7
